             if ("com.android.systemui".contentEquals(pkg) || "android".contentEquals(pkg)) return;
             onAmazonHome = false;
             paused = false;
+            if (isTarget(pkg)) {
+                uncover();
+                return;
+            }
             if (!getPackageName().contentEquals(pkg)) arrived(this);
             return;
